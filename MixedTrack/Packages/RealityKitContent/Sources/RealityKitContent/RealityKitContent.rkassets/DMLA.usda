#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.0.16.0.3)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.4
    }

    def Material "Material"
    {
        token outputs:mtlx:surface.connect = </Root/Material/UnlitSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (440.33984, 89.10156)
        int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 7

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap
            color3f inputs:color = (0, 0, 0) (
                colorSpace = "srgb_displayp3"
            )
            bool inputs:hasPremultipliedAlpha = 1
            float inputs:opacity.connect = </Root/Material/Remap_1.outputs:out>
            float inputs:opacityThreshold
            token outputs:out
            float2 ui:nodegraph:node:pos = (200.51953, 82.45703)
            int ui:nodegraph:node:stackingOrder = 14
        }

        def Shader "Remap_1"
        {
            uniform token info:id = "ND_remap_float"
            float inputs:in.connect = </Root/Material/Multiply.outputs:out>
            float inputs:inhigh = 1
            float inputs:inlow = 0
            float inputs:outhigh = 1.25
            float inputs:outlow = -0.9
            float outputs:out
            float2 ui:nodegraph:node:pos = (-12.042969, 81.171875)
            int ui:nodegraph:node:stackingOrder = 52
        }

        def Shader "Multiply"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/Material/ConstantFloat.outputs:out>
            float inputs:in2.connect = </Root/Material/Separate3.outputs:outz>
            float outputs:out
            float2 ui:nodegraph:node:pos = (-129.5039, 109.19531)
            int ui:nodegraph:node:stackingOrder = 49
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normal_vector3"
            float3 outputs:out
            float2 ui:nodegraph:node:pos = (-442.82422, 121.453125)
            int ui:nodegraph:node:stackingOrder = 46
        }

        def Shader "ConstantFloat"
        {
            uniform token info:id = "ND_constant_float"
            float inputs:value = 1
            float outputs:out
            float2 ui:nodegraph:node:pos = (-328.8125, 19.765625)
            int ui:nodegraph:node:stackingOrder = 47
        }

        def Shader "Separate3"
        {
            uniform token info:id = "ND_separate3_vector3"
            float3 inputs:in.connect = </Root/Material/Normal.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float2 ui:nodegraph:node:pos = (-274.5586, 141.47656)
            int ui:nodegraph:node:stackingOrder = 48
        }
    }
}

